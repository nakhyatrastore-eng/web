# Copy this file to .env.local and fill in once your Shopify store exists.
# Without these, the site runs on mock data automatically.

# Settings > Domains in Shopify admin, the *.myshopify.com one (not nakhyatra.store)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Settings > Apps and sales channels > Develop apps > Create an app
# > Configure Storefront API scopes (unauthenticated_read_product_listings, unauthenticated_read_product_inventory)
# > Install app > reveal "Storefront API access token"
SHOPIFY_STOREFRONT_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# uploadthing.com > create an app > API Keys page.
# Newer dashboards give you a single token; if yours instead shows a
# Secret Key + App ID pair, use UPLOADTHING_SECRET and UPLOADTHING_APP_ID instead.
UPLOADTHING_TOKEN=your_token_here
