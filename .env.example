# Public storefront URL
NEXT_PUBLIC_SITE_URL=https://nakhyatra.store

# Shopify Storefront API (the token remains server-only)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_CHECKOUT_DOMAIN=checkout.nakhyatra.store
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=https://checkout.nakhyatra.store/account

# Custom product handles in Shopify
SHOPIFY_CUSTOM_CASE_HANDLE=create-your-own-metal-phone-case
SHOPIFY_CUSTOM_POSTER_HANDLE=create-your-own-a4-metal-poster

# Customer artwork uploads (server-only)
UPLOADTHING_TOKEN=
